<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="blueprint_demo_partners_umbm" model="populate.blueprint">
        <field name="name">Demo Partners</field>
        <field name="definition_xml" type="xml">
            <create model="res.partner" count="100" id="my_partners">
                <field name="name" generator="fake.company"/>
                <field name="email" eval="name.lower().replace(' ', '-') + '@example.com'"/>
            </create>
        </field>
    </record>
</odoo>
