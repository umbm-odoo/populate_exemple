<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="blueprint_sale_and_invoices_5y" model="populate.blueprint">
        <field name="name">Sale Orders + Invoices - 5 years</field>
        <field name="definition_xml" type="xml">
            <!-- The DB has no product yet, so we import the standard product catalog blueprint -->
            <import ref="product.fake_products" as="catalog">
                <xpath expr="//create[@id='products']" position="attributes">
                    <attribute name="count">30</attribute>
                </xpath>
            </import>

            <!-- Sale orders for our demo partners (created by demo_partner.xml), over the last 5 years -->
            <create model="sale.order" count="300" id="sale_orders_5y" context="{'mail_auto_subscribe_no_notify': True}">
                <field name="partner_id" domain="[('email', 'like', '@example.com')]"/>
                <field name="state" values="{'draft': 2, 'sent': 1, 'sale': 6, 'cancel': 1}"/>
                <!--
                    date_order is a Datetime field, whose default generator (temporal.datetime) works in
                    SECONDS, not days: rate=0.0012 (a days-based rate, see below) would then average
                    ~14 minutes after "start", bunching every record on the same day. Force temporal.date
                    (allowed on Datetime fields too, just loses the time-of-day) to get day-based granularity.
                    rate itself is scaled from the stock sale.fake_sale_demo blueprint (rate=0.003 for a
                    2y/730d window) by 730/1825 so orders stay spread across the full 5y window instead of
                    bunching near "start".
                -->
                <field name="date_order" generator="temporal.date" start="now -5y" end="now" distribution="exponential(rate=0.0012)"/>
                <field name="validity_date" start="today" end="today +30d" null_ratio="0.5"/>
                <field name="client_order_ref" generator="fake.bothify" text="PO-####-????" null_ratio="0.6"/>
                <field name="note" generator="fake.paragraph" null_ratio="0.7"/>
            </create>

            <create model="sale.order.line" count="1200" id="sale_order_lines_5y" context="{'mail_auto_subscribe_no_notify': True}">
                <field name="order_id" ref="sale_orders_5y" partition="True"/>
                <field name="product_id" ref="catalog/products" domain="[('sale_ok', '=', True), ('type', '!=', 'combo')]"/>
                <field name="product_uom_qty" start="1" end="50" distribution="exponential(rate=0.1)"/>
                <field name="price_unit" start="5.0" end="5000.0" distribution="exponential(rate=0.001)"/>
                <field name="discount" start="0" end="30" distribution="exponential(rate=0.2)" null_ratio="0.7"/>
                <field name="sequence" start="1" end="100"/>
            </create>

            <!--
                Customer invoices over the same 5-year window.
                mean/std are scaled from the stock account.account_populate_demo blueprint
                (mean=365, std=180 for a 2y/730d window -> same ratio for a 5y/1825d window)
                so invoices stay spread across the whole period instead of bunching in the first 2 years.
            -->
            <create model="account.move" count="200" id="customer_invoices_5y" context="{'mail_auto_subscribe_no_notify': True}">
                <field name="partner_id" domain="[('email', 'like', '@example.com')]"/>
                <field name="journal_id" domain="[('type', '=', 'sale')]"/>
                <field name="date" start="today -5y" end="today" distribution="normal(mean=912, std=450)"/>
                <field name="invoice_date" start="today -5y" end="today" distribution="normal(mean=912, std=450)"/>
                <field name="invoice_date_due" start="today -5y +30d" end="today +90d" null_ratio="0.3"/>
                <field name="move_type" values="{'out_invoice': 85, 'out_refund': 15}"/>
                <field name="ref" generator="fake.ean" length="13" null_ratio="0.6"/>
            </create>

            <create model="account.move.line" count="600" id="customer_invoice_lines_5y" context="{'check_move_validity': False}">
                <field name="move_id" ref="customer_invoices_5y" partition="True"/>
                <field name="product_id" ref="catalog/products" domain="[('sale_ok', '=', True)]" null_ratio="0.1"/>
                <field name="account_id" domain="[('account_type', '=', 'income')]"/>
                <field name="name" generator="fake.sentence" nb_words="6"/>
                <field name="quantity" start="1.0" end="100.0" distribution="exponential(rate=0.05)"/>
                <field name="price_unit" start="10.0" end="2000.0" distribution="exponential(rate=0.002)"/>
            </create>

            <!-- Post the invoices once their lines exist. parallel=False: sequence locking on the invoice name deadlocks otherwise -->
            <function model="account.move" name="_post" ref="customer_invoices_5y" batched="True" parallel="False"
                      domain="[('line_ids.display_type', 'not in', ('line_section', 'line_subsection', 'line_note'))]">
                <arg name="soft" eval="False"/>
            </function>
        </field>
    </record>
</odoo>
